{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts",
    "src/shared/**/*",
    "vitest.setup.ts"
  ],
  "compilerOptions": {
    "composite": true,
    // Typechecking always runs as `tsc --noEmit ... --composite false` (see
    // package.json's typecheck:web script), so nothing here ever actually
    // gets written — but the editor's own TS server evaluates this file as-is
    // (composite: true, so declaration emit is implied), and without an
    // outDir, composite mode's declaration output would land right next to
    // its source and collide with the hand-written src/preload/index.d.ts.
    "outDir": "dist/web-types",
    "jsx": "react-jsx",
    "paths": {
      "@renderer/*": [
        "./src/renderer/src/*"
      ],
      "@shared/*": [
        "./src/shared/*"
      ],
      // Bare specifier only (no "/*" wildcard) — these four are meant to be
      // imported only from their barrel (index.ts), never a specific file
      // inside them, so a deep import like "@state/PhotoLibraryContext"
      // fails to resolve here rather than silently working.
      "@components": [
        "./src/renderer/src/components/index.ts"
      ],
      "@state": [
        "./src/renderer/src/state/index.ts"
      ],
      "@hooks": [
        "./src/renderer/src/hooks/index.ts"
      ],
      "@utils": [
        "./src/renderer/src/utils/index.ts"
      ]
    }
  }
}
